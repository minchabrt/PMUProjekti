<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/logo"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="@dimen/MediumTopMargin"
    android:orientation="vertical">

    <TextView
        android:id="@+id/maintext"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/MediumTopMargin"
        android:fontFamily="sans-serif-black"
        android:text="Aleksa Mincic"
        android:textAlignment="center"
        android:textSize="48sp" />

    <ImageView
        android:id="@+id/logo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="-60dp"
        android:scaleType="center"
        android:scaleX="0.5"
        android:scaleY="0.5"
        android:src="@drawable/_1701518784022" />

    <TextView
        android:id="@+id/chooseText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="-30dp"
        android:fontFamily="sans-serif-medium"
        android:text="Izaberi željeni tekst:"
        android:textAlignment="center"
        android:textSize="20sp" />

    <EditText
        android:id="@+id/choosen_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/VeryHighMargin"
        android:layout_marginRight="@dimen/VeryHighMargin"
        android:ems="10"
        android:hint="(1, 2 ili 3)"
        android:inputType="text"
        android:textAlignment="center" />

    <Button
        android:id="@+id/choose_btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/VeryHighMargin"
        android:layout_marginRight="@dimen/VeryHighMargin"
        android:text="IZABERI" />

    <ScrollView
        android:id="@+id/scrolltext"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="@dimen/VeryHighMargin"
        android:layout_marginTop="@dimen/HighMargin"
        android:layout_marginRight="@dimen/VeryHighMargin"
        android:layout_marginBottom="@dimen/HighMargin">

        <TextView
            android:id="@+id/scrolltext_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </ScrollView>

</LinearLayout>